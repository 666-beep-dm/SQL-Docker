# ─── Application ───────────────────────────────────────────
APP_NAME=Production Backend App
APP_VERSION=1.0.0
DEBUG=false

# ─── PostgreSQL ─────────────────────────────────────────────
# When running via Docker, POSTGRES_HOST must match the
# docker-compose service name: db
# When running locally, change to: localhost
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# ─── Security ───────────────────────────────────────────────
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=

# ────────────────────────────────────────────────────────────
# ⚠  DO NOT add DATABASE_URL here.
#    It is built automatically in app/core/config.py
#    using urllib.parse.quote_plus() to safely encode
#    any special characters in the password.
# ────────────────────────────────────────────────────────────
